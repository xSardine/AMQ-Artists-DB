# Copy this file to ".env" in this folder (backEnd/.env) before starting the server.
# See backEnd/README.md.

# Set separate plain-text shared passwords. Keep backEnd/.env private and out of Git.
# Empty passwords disable access. Passwords and session tokens are never stored in SQL.
LOG_PASSWORD=
REVIEW_PASSWORD=

# Exact frontend origins allowed for protected browser requests.
FRONTEND_ORIGINS=https://anisongdb.com,http://localhost:4200,http://127.0.0.1:4200

# Production: true. Local HTTP development: false. Blank detects the request host.
AUTH_COOKIE_SECURE=

# Pseudonymize request log IP addresses (recommended). Same IP will map to the
# same alias token, but the raw IP will not be stored in the feed.
REQUEST_LOG_ANONYMIZE_IP=true

# Optional salt for deterministic aliases across server restarts/deployments.
# Set a long random string in backEnd/.env (do not commit private salts).
# If omitted, a random in-memory salt is used at startup.
REQUEST_LOG_IP_HASH_SALT=
